{
  "name": "MySched",
  "short_name": "MySched",
  "description": "Speak your daily schedule and see it at a glance. Synced across all your devices.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
